APP_ENV=development
# Public Vercel deployment requires APP_ENV=production, Neon and the same-origin API proxy.
# See docs/VERCEL-DEPLOYMENT.md. Do not overwrite an existing backend/.env.
# GOOGLE_CLIENT_ID=SERVER_ONLY_PLACEHOLDER
# GOOGLE_CLIENT_SECRET=SERVER_ONLY_PLACEHOLDER
# OAUTH_SESSION_SECRET=AT_LEAST_32_RANDOM_CHARACTERS
# FRONTEND_URL=https://YOUR_FRONTEND_DOMAIN
# GOOGLE_REDIRECT_URI=https://YOUR_FRONTEND_DOMAIN/api/auth/google/callback
# Native Salesforce dispatch stays disabled until controlled testing is approved.
SALESFORCE_DISPATCH_ENABLED=false
# SALESFORCE_INSTANCE_URL=https://YOUR_DOMAIN.my.salesforce.com
# SALESFORCE_CLIENT_ID=SERVER_ONLY_PLACEHOLDER
# SALESFORCE_CLIENT_SECRET=SERVER_ONLY_PLACEHOLDER
# Optional, only after verifying exact field API names in Salesforce Describe:
# SALESFORCE_RESULT_SURVEY_FIELD=VERIFIED_FIELD_API_NAME
# SALESFORCE_RESULT_STATUS_FIELD=VERIFIED_FIELD_API_NAME
# Default local development; never put real credentials in this example.
DATABASE_URL=sqlite+pysqlite:///./kobentra-local.db
# Future Neon configuration PLACEHOLDER ONLY; do not connect/migrate without approval.
# DATABASE_URL=postgresql+psycopg://DB_USER:URL_ENCODED_PASSWORD@NEON_HOST/DB_NAME?sslmode=verify-full&channel_binding=require
# postgresql:// is also accepted and normalized to the installed psycopg driver.
# Omitted PostgreSQL TLS options default to verify-full and channel_binding=require.
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# Optional, server-only: exact verified Google sub, securely provisioned by the operator.
# Unset means administration is denied to everyone. Never expose via VITE_*.
# PLATFORM_OWNER_GOOGLE_SUBJECT=<verified-owner-google-sub>
# Destructive Salesforce step disabled by default. Uses recoverable Recycle Bin deletion.
SALESFORCE_BUSINESS_DELETION_ENABLED=false
# Public shared assessment destination, not a secret or unique response tracking URL.
# Defaults to this verified public destination. Set empty to disable launching.
SURVEYVISTA_LAUNCH_URL=https://orgfarm-7cee962a58-dev-ed.develop.my.site.com/kobentraassess/s/survey-response?recordId=a0Zaj00000JUZOn&logicalId=65f02f00-7066-11ca-ca73-bc8541f3089c
